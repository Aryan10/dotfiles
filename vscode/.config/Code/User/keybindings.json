// Place your key bindings in this file to override the defaults
[
  {
    "key": "ctrl+shift+insert",
    "command": "editor.foldAllExcept",
    "when": "editorTextFocus && foldingEnabled"
  },
  {
    "key": "ctrl+k ctrl+oem_minus",
    "command": "-editor.foldAllExcept",
    "when": "editorTextFocus && foldingEnabled"
  },
  {
    "key": "ctrl+alt+b",
    "command": "-C_Cpp_Runner.buildSingleFile",
    "when": "C_Cpp_Runner:activatedExtension"
  },
  {
    "key": "ctrl+oem_7",
    "command": "cph.runTestCases"
  },
  {
    "key": "ctrl+alt+b",
    "command": "-cph.runTestCases"
  },
  {
    "key": "ctrl+enter",
    "command": "-github.copilot.generate",
    "when": "editorTextFocus && github.copilot.activated && !commentEditorFocused && !inInteractiveInput && !interactiveEditorFocused"
  },
  {
    "key": "ctrl+oem_1 ctrl+oem_1",
    "command": "editor.foldLevel1",
    "when": "editorTextFocus && foldingEnabled"
  },
  {
    "key": "ctrl+k ctrl+1",
    "command": "-editor.foldLevel1",
    "when": "editorTextFocus && foldingEnabled"
  },
  {
    "key": "alt+oem_3",
    "command": "-workbench.action.editorDictation.start",
    "when": "hasSpeechProvider && !editorReadonly && !speechToTextInProgress"
  },
  {
    "key": "alt+oem_3",
    "command": "openInIntegratedTerminal"
  },
  {
    "key": "alt+f",
    "command": "editor.action.formatDocument",
    "when": "editorHasDocumentFormattingProvider && editorTextFocus && !editorReadonly && !inCompositeEditor"
  },
  {
    "key": "shift+alt+f",
    "command": "-editor.action.formatDocument",
    "when": "editorHasDocumentFormattingProvider && editorTextFocus && !editorReadonly && !inCompositeEditor"
  },
  {
    "key": "ctrl+1",
    "command": "-workbench.action.focusFirstEditorGroup"
  },
  {
    "key": "ctrl+0",
    "command": "-workbench.action.focusSideBar"
  },
  {
    "key": "ctrl+1",
    "command": "workbench.action.toggleSidebarVisibility"
  },
  {
    "key": "ctrl+b",
    "command": "-workbench.action.toggleSidebarVisibility"
  },
  {
    "key": "ctrl+2",
    "command": "-workbench.action.focusSecondEditorGroup"
  },
  {
    "key": "ctrl+2",
    "command": "workbench.action.toggleAuxiliaryBar"
  },
  {
    "key": "ctrl+alt+b",
    "command": "-workbench.action.toggleAuxiliaryBar"
  },
  {
    "key": "alt+j",
    "command": "-supermaven.newConversationTab"
  },
  {
    "key": "ctrl+shift+i",
    "command": "-supermaven.addToChat"
  },
  {
    "key": "ctrl+i",
    "command": "-supermaven.editWithSupermaven"
  },
  {
    "key": "ctrl+z",
    "command": "-supermaven.undoJump",
    "when": "supermaven.hasJumped"
  },
  {
    "key": "ctrl+i",
    "command": "-workbench.action.chat.startVoiceChat",
    "when": "chatIsEnabled && hasSpeechProvider && inChatInput && !chatSessionRequestInProgress && !editorFocus && !notebookEditorFocused && !scopedVoiceChatGettingReady && !speechToTextInProgress || chatIsEnabled && hasSpeechProvider && inlineChatFocused && !chatSessionRequestInProgress && !editorFocus && !notebookEditorFocused && !scopedVoiceChatGettingReady && !speechToTextInProgress"
  },
  {
    "key": "ctrl+i",
    "command": "-workbench.action.chat.stopListeningAndSubmit",
    "when": "inChatInput && voiceChatInProgress && scopedVoiceChatInProgress == 'editor' || inChatInput && voiceChatInProgress && scopedVoiceChatInProgress == 'inline' || inChatInput && voiceChatInProgress && scopedVoiceChatInProgress == 'quick' || inChatInput && voiceChatInProgress && scopedVoiceChatInProgress == 'view' || inlineChatFocused && voiceChatInProgress && scopedVoiceChatInProgress == 'editor' || inlineChatFocused && voiceChatInProgress && scopedVoiceChatInProgress == 'inline' || inlineChatFocused && voiceChatInProgress && scopedVoiceChatInProgress == 'quick' || inlineChatFocused && voiceChatInProgress && scopedVoiceChatInProgress == 'view'"
  },
  {
    "key": "ctrl+i y",
    "command": "-terminalAllInOne.changeCursorStyle",
    "when": "!config.terminalAllInOne.disableAllKeybindings"
  },
  {
    "key": "ctrl+i w",
    "command": "-terminalAllInOne.changeCursorWidth",
    "when": "!config.terminalAllInOne.disableAllKeybindings"
  },
  {
    "key": "ctrl+i f",
    "command": "-terminalAllInOne.changeFontSize",
    "when": "!config.terminalAllInOne.disableAllKeybindings"
  },
  {
    "key": "ctrl+i q",
    "command": "-terminalAllInOne.changeFontWeight",
    "when": "!config.terminalAllInOne.disableAllKeybindings"
  },
  {
    "key": "ctrl+i t",
    "command": "-terminalAllInOne.chooseTerminalTheme",
    "when": "!config.terminalAllInOne.disableAllKeybindings"
  },
  {
    "key": "ctrl+i backspace",
    "command": "-terminalAllInOne.clearTerminal",
    "when": "!config.terminalAllInOne.disableAllKeybindings"
  },
  {
    "key": "ctrl+i c",
    "command": "-terminalAllInOne.createNewTerminal",
    "when": "!config.terminalAllInOne.disableAllKeybindings"
  },
  {
    "key": "ctrl+i oem_minus",
    "command": "-terminalAllInOne.decreaseFontSize",
    "when": "!config.terminalAllInOne.disableAllKeybindings"
  },
  {
    "key": "ctrl+i d",
    "command": "-terminalAllInOne.deleteCurrentTerminal",
    "when": "!config.terminalAllInOne.disableAllKeybindings"
  },
  {
    "key": "ctrl+i oem_period",
    "command": "-terminalAllInOne.focusNextTerminal",
    "when": "!config.terminalAllInOne.disableAllKeybindings"
  },
  {
    "key": "ctrl+i oem_comma",
    "command": "-terminalAllInOne.focusPreviousTerminal",
    "when": "!config.terminalAllInOne.disableAllKeybindings"
  },
  {
    "key": "ctrl+i oem_plus",
    "command": "-terminalAllInOne.increaseFontSize",
    "when": "!config.terminalAllInOne.disableAllKeybindings"
  },
  {
    "key": "ctrl+i r",
    "command": "-terminalAllInOne.renameCurrentTerminal",
    "when": "!config.terminalAllInOne.disableAllKeybindings"
  },
  {
    "key": "ctrl+i enter",
    "command": "-terminalAllInOne.runScript",
    "when": "!config.terminalAllInOne.disableAllKeybindings"
  },
  {
    "key": "ctrl+i 0",
    "command": "-terminalAllInOne.runScript",
    "when": "!config.terminalAllInOne.disableAllKeybindings"
  },
  {
    "key": "ctrl+i 1",
    "command": "-terminalAllInOne.runScript",
    "when": "!config.terminalAllInOne.disableAllKeybindings"
  },
  {
    "key": "ctrl+i 2",
    "command": "-terminalAllInOne.runScript",
    "when": "!config.terminalAllInOne.disableAllKeybindings"
  },
  {
    "key": "ctrl+i 3",
    "command": "-terminalAllInOne.runScript",
    "when": "!config.terminalAllInOne.disableAllKeybindings"
  },
  {
    "key": "ctrl+i 4",
    "command": "-terminalAllInOne.runScript",
    "when": "!config.terminalAllInOne.disableAllKeybindings"
  },
  {
    "key": "ctrl+i 5",
    "command": "-terminalAllInOne.runScript",
    "when": "!config.terminalAllInOne.disableAllKeybindings"
  },
  {
    "key": "ctrl+i 6",
    "command": "-terminalAllInOne.runScript",
    "when": "!config.terminalAllInOne.disableAllKeybindings"
  },
  {
    "key": "ctrl+i 7",
    "command": "-terminalAllInOne.runScript",
    "when": "!config.terminalAllInOne.disableAllKeybindings"
  },
  {
    "key": "ctrl+i 8",
    "command": "-terminalAllInOne.runScript",
    "when": "!config.terminalAllInOne.disableAllKeybindings"
  },
  {
    "key": "ctrl+i 9",
    "command": "-terminalAllInOne.runScript",
    "when": "!config.terminalAllInOne.disableAllKeybindings"
  },
  {
    "key": "ctrl+i s",
    "command": "-terminalAllInOne.selectDefaultShell",
    "when": "!config.terminalAllInOne.disableAllKeybindings"
  },
  {
    "key": "ctrl+i oem_6",
    "command": "-terminalAllInOne.splitTerminal",
    "when": "!config.terminalAllInOne.disableAllKeybindings"
  },
  {
    "key": "ctrl+i b",
    "command": "-terminalAllInOne.toggleBlinkingCursor",
    "when": "!config.terminalAllInOne.disableAllKeybindings"
  },
  {
    "key": "ctrl+i m",
    "command": "-terminalAllInOne.toggleMaxTerm",
    "when": "!config.terminalAllInOne.disableAllKeybindings"
  },
  {
    "key": "ctrl+i",
    "command": "-editor.action.triggerSuggest",
    "when": "editorHasCompletionItemProvider && textInputFocus && !editorReadonly && !suggestWidgetVisible"
  },
  {
    "key": "ctrl+alt+w",
    "command": "workbench.action.terminal.kill"
  },
  {
    "key": "shift+alt+oem_3",
    "command": "workbench.action.terminal.openNativeConsole",
    "when": "!terminalFocus"
  },
  {
    "key": "ctrl+shift+c",
    "command": "-workbench.action.terminal.openNativeConsole",
    "when": "!terminalFocus"
  },
  {
    "key": "ctrl+3",
    "command": "-workbench.action.focusThirdEditorGroup"
  },
  {
    "key": "ctrl+3",
    "command": "workbench.action.togglePanel"
  },
  {
    "key": "ctrl+j",
    "command": "-workbench.action.togglePanel"
  }
]
